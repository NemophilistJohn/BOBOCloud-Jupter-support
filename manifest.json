{
  "schemaVersion": 2,
  "id": "bobocloud.notebook-preview",
  "displayName": "Notebook Preview",
  "description": "Open and edit Jupyter notebooks with sidebar navigation and offline Markdown, math, and saved outputs.",
  "version": "1.2.0",
  "engines": { "bobocloud": ">=2.8.1 <2.9.0", "pluginApi": "^1.9.0" },
  "main": "dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "permissions": ["documentViews.register", "documents.read", "documents.write", "documents.analyze", "sourceControl.register"],
  "contributes": {
    "documentViewers": [{
      "id": "bobocloud.notebook-preview.jupyter",
      "extensions": [".ipynb"],
      "entry": "dist/notebook.js",
      "resources": ["dist/view.css"],
      "priority": 200
    }]
  },
  "localization": {
    "default": "language-packs/en/messages.json",
    "en": "language-packs/en/messages.json",
    "zh-CN": "language-packs/zh-CN/messages.json",
    "ja": "language-packs/ja/messages.json"
  }
}
